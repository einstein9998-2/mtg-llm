    Activated(text: "0: Add {C}{C}{C}.", cost: [Loyalty(0)], effect: AddMana(color: C, n: 3)),
  ]),
  (name: "The One Ring", cost: "{4}", types: "ARTIFACT", supertypes: "LEGENDARY", keywords: "INDESTRUCTIBLE", abilities: [
    Triggered(text: "When The One Ring enters, if you cast it, you gain protection from everything until your next turn.", on: Enters(filter: (self_only: true)), cond: WasCast(), effect: PlayerFx(who: You, fx: ProtectionFromEverything, until: YourNextTurn)),
    Triggered(text: "At the beginning of your upkeep, you lose 1 life for each burden counter on The One Ring.", on: BeginStep(step: Upkeep, whose: You), effect: LoseLife(who: You, n: Counters(This, Other(0)))),
    Activated(text: "{T}: Put a burden counter on The One Ring, then draw a card for each burden counter on The One Ring.", cost: [TapSelf],
      effect: Seq([AddCounters(objs: One(This), kind: Other(0), n: Const(1)), Draw(who: You, n: Counters(This, Other(0)))])),
  ]),
  (name: "Kozilek's Command", cost: "{X}{C}{C}", types: "KINDRED | INSTANT", subtypes: ["Eldrazi"], abilities: [
