  p2: cast Flickerwisp
  p2: pass
  p1: pass
  p2: pick Plains@p1
  p2: at END_OF_TURN
  p2: pass
  p1: pass
expect:
  controls p1 "Plains"
  untapped p1 "Plains"

=== flickerwisp-exiled-token-gone
