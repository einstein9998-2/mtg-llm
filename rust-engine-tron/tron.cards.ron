    Activated(text: "{3}, {T}: Target creature can't be blocked this turn.", cost: [Mana("{3}"), TapSelf], targets: [(objects: (types_any: "CREATURE"))],
      effect: Continuous(objs: One(Target(0)), layer: L6, effect: GrantKeywords("UNBLOCKABLE"), until: EndOfTurn)),
  ]),
  (name: "Tormod's Crypt", cost: "{0}", types: "ARTIFACT", abilities: [
    Activated(text: "{T}, Sacrifice this artifact: Exile target player's graveyard.", cost: [TapSelf, SacrificeSelf], targets: [(players: Any)], effect: ExileGraveyard(who: Target(0))),
  ]),
  (name: "Liquimetal Coating", cost: "{2}", types: "ARTIFACT", abilities: [
    Activated(text: "{T}: Target permanent becomes an artifact in addition to its other types until end of turn.", cost: [TapSelf], targets: [(objects: ())],
