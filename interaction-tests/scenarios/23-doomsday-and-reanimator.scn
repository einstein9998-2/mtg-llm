# Doomsday (p1) and Reanimator (p1 or p2): pile mechanics, library-out wins, reanimation spells, graveyard interaction.
# Conventions: p1 = first seat, p2 = second seat, both scripted; see ../README.md.

=== doomsday-keeps-five-exiles-rest
title: Doomsday lets you choose five cards from library and graveyard, exiles the rest, and you lose half your life rounded up
ref: Doomsday Oracle
state:
  humanhand=Doomsday
  humanbattlefield=Swamp;Swamp;Swamp
  humanlibrary=Brainstorm;Ponder;Lotus Petal;Thoughtseize;Force of Will;Island;Island;Island
  humangraveyard=Dark Ritual;Daze
script:
  p1: cast Doomsday
  p1: pass
  p2: pass
  p1: pick Brainstorm
  p1: pick Lotus Petal
  p1: pick Force of Will
  p1: pick Dark Ritual
  p1: pick Daze
expect:
  life p1 == 10
  zone p1 library size == 5
  zone p1 library has "Daze"
  zone p1 graveyard size == 1
  zone p1 exile size == 5
  zone p1 exile has "Ponder"

=== doomsday-pile-order
title: Doomsday puts the chosen five on top in the order chosen
ref: Doomsday Oracle
state:
  humanhand=Doomsday
  humanbattlefield=Swamp;Swamp;Swamp
  humanlibrary=Brainstorm;Ponder;Lotus Petal;Thoughtseize;Force of Will;Island;Island;Island
script:
  p1: cast Doomsday
  p1: pass
  p2: pass
  p1: pick Brainstorm
  p1: pick Lotus Petal
  p1: pick Force of Will
  p1: pick Ponder
  p1: pick Thoughtseize
  p1: pick Force of Will;Brainstorm;Lotus Petal;Ponder;Thoughtseize
expect:
  top p1 1 "Force of Will"
  top p1 2 "Brainstorm"
  top p1 5 "Thoughtseize"

=== doomsday-life-rounds-up
title: Doomsday at 7 life costs 4 (half rounded up), leaving 3
ref: Doomsday Oracle
state:
  humanlife=7
  humanhand=Doomsday
  humanbattlefield=Swamp;Swamp;Swamp
  humanlibrary=Brainstorm;Ponder;Lotus Petal;Thoughtseize;Force of Will;Island
script:
  p1: cast Doomsday
  p1: pass
  p2: pass
  p1: pick Brainstorm
  p1: pick Lotus Petal
  p1: pick Force of Will
  p1: pick Ponder
  p1: pick Thoughtseize
expect:
  life p1 == 3

=== doomsday-fewer-than-five-cards
title: Doomsday with a four-card library and graveyard total keeps all of them
ref: Doomsday Oracle ("five cards" means up to five if fewer exist)
state:
  humanhand=Doomsday
  humanbattlefield=Swamp;Swamp;Swamp
  humanlibrary=Brainstorm;Ponder
  humangraveyard=Dark Ritual;Daze
script:
  p1: cast Doomsday
  p1: pass
  p2: pass
  p1: pick all
expect:
  zone p1 library size == 4
  life p1 == 10

=== doomsday-countered-by-fow-no-life-loss
title: A countered Doomsday costs no life and exiles nothing
ref: Doomsday Oracle; Force of Will Oracle
state:
  humanhand=Doomsday
  humanbattlefield=Swamp;Swamp;Swamp
  humanlibrary=Brainstorm;Ponder;Island
  aihand=Force of Will;Brainstorm
script:
  p1: cast Doomsday
  p1: pass
  p2: when-stack Doomsday
  p2: cast Force of Will ~alt -> Doomsday
  p2: pick Brainstorm
expect:
  life p1 == 20
  zone p1 library size == 3
  zone p1 graveyard has "Doomsday"

=== thassa-oracle-wins-with-empty-library
title: Thassa's Oracle wins the game when the controller's library is empty (X >= cards in library)
ref: Thassa's Oracle Oracle
state:
  humanhand=Thassa's Oracle
  humanbattlefield=Island;Island
  humanlibrary=
script:
  p1: cast Thassa's Oracle
  p1: pass
  p2: pass
expect:
  lost p2
  gameover

=== thassa-oracle-no-win-with-large-library
title: Thassa's Oracle does not win while the library has more cards than the devotion to blue (2)
ref: Thassa's Oracle Oracle
state:
  humanhand=Thassa's Oracle
  humanbattlefield=Island;Island
  humanlibrary=Brainstorm;Ponder;Island;Island;Island
script:
  p1: cast Thassa's Oracle
  p1: pass
  p2: pass
  p1: pick none
expect:
  alive p2

=== thassa-oracle-wins-at-exact-devotion
title: Thassa's Oracle wins with exactly two cards in library (devotion 2 from its own UU)
ref: Thassa's Oracle Oracle
state:
  humanhand=Thassa's Oracle
  humanbattlefield=Island;Island
  humanlibrary=Brainstorm;Ponder
script:
  p1: cast Thassa's Oracle
  p1: pass
  p2: pass
expect:
  lost p2

=== thassa-oracle-pile-bottoms-extra
title: Thassa's Oracle keeps one chosen card on top and sends the rest to the bottom
ref: Thassa's Oracle Oracle
state:
  humanhand=Thassa's Oracle
  humanbattlefield=Island;Island
  humanlibrary=Brainstorm;Ponder;Island;Island;Island
script:
  p1: cast Thassa's Oracle
  p1: pass
  p2: pass
  p1: pick Ponder
expect:
  top p1 1 "Ponder"
  alive p2

=== cavern-of-souls-makes-creature-uncounterable
title: Cavern of Souls (naming Merfolk) mana makes Thassa's Oracle uncounterable: Force of Will cannot counter it
ref: Cavern of Souls Oracle
state:
  humanhand=Thassa's Oracle
  humanbattlefield=Cavern of Souls|ChosenType:Merfolk;Island
  humanlibrary=
  aihand=Force of Will;Brainstorm
script:
  p1: cast Thassa's Oracle
  p1: pass
  p2: when-stack Thassa's Oracle
  p2: cast Force of Will ~alt -> Thassa's Oracle
  p2: pick Brainstorm
expect:
  controls p1 "Thassa's Oracle"

=== jace-draws-from-empty-library-win
title: Jace, Wielder of Mysteries wins the game if you would draw with an empty library
ref: Jace, Wielder of Mysteries Oracle
state:
  humanbattlefield=Jace, Wielder of Mysteries|Counters:LOYALTY=4
  humanlibrary=Island;Island
script:
  p1: activate Jace, Wielder of Mysteries ~Target player mills -> p1
  p1: pass
  p2: pass
expect:
  lost p2

=== lion-eye-diamond-mana
title: Lion's Eye Diamond discards the hand and gives three mana of one color
ref: Lion's Eye Diamond Oracle
state:
  humanhand=Brainstorm;Ponder;Doomsday
  humanbattlefield=Lion's Eye Diamond
script:
  p1: activate Lion's Eye Diamond ~Add three
  p1: pick black
  p1: check zone p1 hand size == 0
expect:
  zone p1 graveyard size == 4
  mana p1 == 3

