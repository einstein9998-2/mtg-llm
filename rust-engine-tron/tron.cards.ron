// Colorless Tron (Brady's list, 2026-10-06), RFC 0007. Oracle text per Savecraft card_search (Scryfall).
// Not modeled (documented limits, see rfcs/0007): Urza's Saga and Summon: Bahamut (Saga rules, RFC 0006), Karn -2, Ugin -11,
// Argentum Masticore, Mycosynth Lattice, Eldrazi Confluence, Extinguisher Battleship station, Mishra's Research Desk unearth.
[
  (name: "Urza's Tower", types: "LAND", subtypes: ["Urza's", "Tower"], abilities: [
    // 1 + 2 * [Mine] * [Power-Plant]
    Activated(text: "{T}: Add {C}. If you control an Urza's Mine and an Urza's Power-Plant, add {C}{C}{C} instead.", cost: [TapSelf], is_mana: true,
      effect: AddManaExpr(color: C, n: Plus(Const(1), Times(Const(2), Times(Min(Const(1), Count(subtypes_any: ["Mine"], controller: You)), Min(Const(1), Count(subtypes_any: ["Power-Plant"], controller: You))))))),
  ]),
  (name: "Urza's Workshop", types: "LAND", subtypes: ["Urza's"], abilities: [
    Activated(text: "{T}: Add {C}.", cost: [TapSelf], is_mana: true, effect: AddMana(color: C, n: 1)),
    // Metalcraft: the amount is 0 (not offered) without three artifacts; the activation condition of the Oracle text is the amount.
    Activated(text: "Metalcraft: {T}: Add {C} for each Urza's land you control. Activate only if you control three or more artifacts.", cost: [TapSelf], is_mana: true,
      effect: AddManaExpr(color: C, n: Times(Count(subtypes_any: ["Urza's"], controller: You), Min(Const(1), Max(Const(0), Minus(Count(types_any: "ARTIFACT", controller: You), Const(2))))))),
  ]),
  (name: "Urza's Mine", types: "LAND", subtypes: ["Urza's", "Mine"], abilities: [
    Activated(text: "{T}: Add {C}. If you control an Urza's Power-Plant and an Urza's Tower, add {C}{C} instead.", cost: [TapSelf], is_mana: true,
      effect: AddManaExpr(color: C, n: Plus(Const(1), Times(Min(Const(1), Count(subtypes_any: ["Power-Plant"], controller: You)), Min(Const(1), Count(subtypes_any: ["Tower"], controller: You)))))),
  ]),
  (name: "Urza's Power Plant", types: "LAND", subtypes: ["Urza's", "Power-Plant"], abilities: [
    Activated(text: "{T}: Add {C}. If you control an Urza's Mine and an Urza's Tower, add {C}{C} instead.", cost: [TapSelf], is_mana: true,
      effect: AddManaExpr(color: C, n: Plus(Const(1), Times(Min(Const(1), Count(subtypes_any: ["Mine"], controller: You)), Min(Const(1), Count(subtypes_any: ["Tower"], controller: You)))))),
  ]),
  (name: "Planar Nexus", types: "LAND", subtypes: ["Cave", "Desert", "Gate", "Lair", "Locus", "Mine", "Power-Plant", "Sphere", "Tower", "Urza's"], abilities: [
    Activated(text: "{T}: Add {C}.", cost: [TapSelf], is_mana: true, effect: AddMana(color: C, n: 1)),
    Activated(text: "{1}, {T}: Add one mana of any color.", cost: [Mana("{1}"), TapSelf], is_mana: true, effect: AddManaAny(n: Const(1))),
  ]),
  (name: "Expedition Map", cost: "{1}", types: "ARTIFACT", abilities: [
    Activated(text: "{2}, {T}, Sacrifice this artifact: Search your library for a land card, reveal it, put it into your hand, then shuffle.", cost: [Mana("{2}"), TapSelf, SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND"), dest: Hand)),
  ]),
  (name: "Pithing Needle", cost: "{1}", types: "ARTIFACT", abilities: [
    EntersChoice(CardName),
    Restrict(what: CantActivate(sources: (chosen_name: true), except_mana: true)),
  ]),
  (name: "Voltaic Key", cost: "{1}", types: "ARTIFACT", abilities: [
