# Boros Aggro (p1) vs BW Death and Taxes (p2): ETB triggers, replacement effects, evoke/impending, Aether Vial, Spider-Woman, Voice of Victory, Phlage.
# Conventions: p1 = first seat, p2 = second seat, both scripted; see ../README.md.

=== spider-woman-opponent-creature-enters-tapped
title: With Spider-Woman out, an opponent's creature (Phelia, flashed in) enters tapped
ref: Spider-Woman, Stunning Savior Oracle (Venom Blast)
state:
  humanbattlefield=Spider-Woman, Stunning Savior
  aihand=Phelia, Exuberant Shepherd
  aibattlefield=Plains;Plains
script:
  p1: pass
  p2: cast Phelia, Exuberant Shepherd
  p2: pass
  p1: pass
expect:
  tapped p2 "Phelia, Exuberant Shepherd"

=== spider-woman-opponent-artifact-enters-tapped
title: With Spider-Woman out, an opponent's artifact (Aether Vial) enters tapped
ref: Spider-Woman, Stunning Savior Oracle
state:
  turn=2
  activeplayer=ai
  activephase=MAIN1
  humanbattlefield=Spider-Woman, Stunning Savior
  aihand=Aether Vial
  aibattlefield=Plains
script:
  p2: cast Aether Vial
  p2: pass
  p1: pass
expect:
  tapped p2 "Aether Vial"

=== spider-woman-own-creature-untapped
title: Spider-Woman only taps opponents' creatures: the controller's own creature enters untapped
ref: Spider-Woman, Stunning Savior Oracle
state:
  humanhand=Ocelot Pride
  humanbattlefield=Spider-Woman, Stunning Savior;Plains
script:
  p1: cast Ocelot Pride
  p1: pass
  p2: pass
expect:
  untapped p1 "Ocelot Pride"

=== spider-woman-aether-vial-creature-enters-tapped
title: A creature put onto the battlefield with Aether Vial still enters tapped under Spider-Woman
ref: Spider-Woman, Stunning Savior Oracle; Aether Vial Oracle
state:
  humanbattlefield=Spider-Woman, Stunning Savior
  aihand=Phelia, Exuberant Shepherd
  aibattlefield=Aether Vial|Counters:CHARGE=2
script:
  p2: activate Aether Vial
  p2: pick Phelia, Exuberant Shepherd
  p2: pass
  p1: pass
expect:
  controls p2 "Phelia, Exuberant Shepherd"
  tapped p2 "Phelia, Exuberant Shepherd"

=== aether-vial-cannot-be-countered
title: A creature put onto the battlefield with Aether Vial uses no stack and cannot be countered
ref: Aether Vial Oracle; CR 603.3 (ability resolves, creature is never cast)
state:
  humanhand=Lightning Bolt
  humanbattlefield=Mountain
  aihand=Phelia, Exuberant Shepherd
  aibattlefield=Aether Vial|Counters:CHARGE=2
script:
  p2: activate Aether Vial
  p2: pick Phelia, Exuberant Shepherd
  p2: pass
  p1: pass
expect:
  controls p2 "Phelia, Exuberant Shepherd"
  spells p2 == 0

=== aether-vial-wrong-mana-value
title: Aether Vial with two charge counters offers a mana value 2 creature but not a mana value 3 one
ref: Aether Vial Oracle
state:
  aihand=Skyclave Apparition;Phelia, Exuberant Shepherd
  aibattlefield=Aether Vial|Counters:CHARGE=2
script:
  p2: activate Aether Vial
  p2: pick !Skyclave Apparition
  p2: pass
  p1: pass
expect:
  not controls p2 "Skyclave Apparition"
  controls p2 "Phelia, Exuberant Shepherd"

=== phlage-etb-sacrificed-unless-escaped
title: Phlage cast from hand deals 3 damage, gains 3 life, then is sacrificed
ref: Phlage, Titan of Fire's Fury Oracle
state:
  humanhand=Phlage, Titan of Fire's Fury
  humanbattlefield=Mountain;Plains;Plains
script:
  p1: cast Phlage, Titan of Fire's Fury
  p1: pass
  p2: pass
  p1: pick p2
expect:
  life p2 == 17
  life p1 == 23
  zone p1 graveyard has "Phlage, Titan of Fire's Fury"
  not controls p1 "Phlage, Titan of Fire's Fury"

=== phlage-escape-stays
title: Phlage cast with escape (exile five other cards) stays on the battlefield
ref: Phlage, Titan of Fire's Fury Oracle; CR 702.138
state:
  humanbattlefield=Mountain;Mountain;Plains;Plains
  humangraveyard=Phlage, Titan of Fire's Fury;Island;Island;Island;Island;Island
script:
  p1: cast Phlage, Titan of Fire's Fury ~escape
  p1: pick Island;Island;Island;Island;Island
  p1: pass
  p2: pass
  p1: pick p2
expect:
  controls p1 "Phlage, Titan of Fire's Fury"
  life p2 == 17
  life p1 == 23

=== phlage-escape-needs-five-other-cards
title: Phlage cannot escape with only four other cards in the graveyard
ref: Phlage, Titan of Fire's Fury Oracle
state:
  humanbattlefield=Mountain;Mountain;Plains;Plains
  humangraveyard=Phlage, Titan of Fire's Fury;Island;Island;Island;Island
script:
  p1: try cast Phlage, Titan of Fire's Fury ~escape
  p1: pass
expect:
  zone p1 graveyard has "Phlage, Titan of Fire's Fury"
  not controls p1 "Phlage, Titan of Fire's Fury"

=== goblin-bombardment-sacrifice-damage
title: Goblin Bombardment sacrifices a creature as a cost and deals 1 damage to any target
ref: Goblin Bombardment Oracle
state:
  humanbattlefield=Goblin Bombardment;Ocelot Pride
script:
  p1: activate Goblin Bombardment -> p2
  p1: pick Ocelot Pride
  p1: pass
  p2: pass
expect:
  life p2 == 19
  zone p1 graveyard has "Ocelot Pride"

=== goblin-bombardment-in-response-to-removal
title: Sacrificing a creature to Bombardment in response to Swords means no lifegain from Swords
ref: Goblin Bombardment Oracle; Swords to Plowshares Oracle (no exile, no life)
state:
  humanbattlefield=Goblin Bombardment;Ocelot Pride
  turn=2
  activeplayer=ai
  activephase=MAIN1
  aihand=Swords to Plowshares
  aibattlefield=Plains
script:
  p2: cast Swords to Plowshares -> Ocelot Pride
  p2: pass
  p1: when-stack Swords to Plowshares
  p1: activate Goblin Bombardment -> p2
  p1: pick Ocelot Pride
  p1: pass
  p2: pass
expect:
  life p1 == 20
  life p2 == 19
  zone p1 graveyard has "Ocelot Pride"

=== voice-of-victory-blocks-opponent-spells-on-my-turn
title: Voice of Victory stops the opponent casting spells during its controller's turn (Solitude evoke is refused)
ref: Voice of Victory Oracle
state:
  humanbattlefield=Voice of Victory
  aihand=Solitude;Skyclave Apparition
  aibattlefield=Plains;Plains;Plains;Plains;Plains
script:
  p2: try cast Solitude
  p2: pass
  p1: pass
expect:
  controls p1 "Voice of Victory"
  zone p2 hand has "Solitude"

=== voice-of-victory-allows-spells-on-opponents-turn
title: Voice of Victory does not stop the opponent casting spells during the opponent's own turn
ref: Voice of Victory Oracle
state:
  turn=2
  activeplayer=ai
  activephase=MAIN1
  humanbattlefield=Voice of Victory
  aihand=Skyclave Apparition
  aibattlefield=Plains;Plains;Plains
script:
  p2: cast Skyclave Apparition
  p2: pass
  p1: pass
  p2: pick Voice of Victory
expect:
  controls p2 "Skyclave Apparition"
  zone p1 exile has "Voice of Victory"

=== voice-of-victory-mobilize
title: Voice of Victory attacks with two tapped and attacking 1/1 Warrior tokens that are sacrificed at end step
ref: Voice of Victory Oracle; CR 702.181
state:
  humanbattlefield=Voice of Victory
script:
  p1: at COMBAT_BEGIN
  p1: attack Voice of Victory -> p2
  p1: at COMBAT_DAMAGE
  p1: check controls p1 "Warrior Token"
  p1: at END_OF_TURN
  p1: pass
  p2: pass
expect:
  life p2 == 17
  not controls p1 "Warrior Token"

=== ocelot-pride-end-step-cat
title: Ocelot Pride makes a 1/1 Cat at your end step if you gained life this turn
ref: Ocelot Pride Oracle
state:
  humanbattlefield=Ocelot Pride
  humanhand=Lightning Bolt
  turn=3
script:
  p1: at END_OF_TURN
  p1: pass
  p2: pass
expect:
  not controls p1 "Cat Token"

=== ocelot-pride-with-lifegain
title: Ocelot Pride creates a Cat at end step after lifegain (Phlage's 3 life)
ref: Ocelot Pride Oracle
state:
  humanbattlefield=Ocelot Pride;Mountain;Plains;Plains
  humanhand=Phlage, Titan of Fire's Fury
script:
  p1: cast Phlage, Titan of Fire's Fury
  p1: pass
  p2: pass
  p1: pick p2
  p1: at END_OF_TURN
  p1: pass
  p2: pass
expect:
  controls p1 "Cat Token"

=== ocelot-pride-city-blessing-copies-tokens
title: With the city's blessing Ocelot Pride copies each token that entered this turn (Guide of Souls gives the lifegain, Ajani makes a token)
ref: Ocelot Pride Oracle; CR 702.131 (ascend)
state:
  humanbattlefield=Ocelot Pride;Guide of Souls;Plains;Plains;Plains;Plains;Plains;Plains;Plains;Plains
  humanhand=Ajani, Nacatl Pariah
  turn=3
script:
  p1: cast Ajani, Nacatl Pariah
  p1: pass
  p2: pass
  p1: at END_OF_TURN
  p1: pass
  p2: pass
expect:
  zone p1 battlefield count "Cat Warrior Token" == 2
  zone p1 battlefield count "Cat Token" == 2

=== ajani-etb-token
title: Ajani, Nacatl Pariah makes a 2/1 Cat Warrior token when it enters
ref: Ajani, Nacatl Pariah Oracle
state:
  humanhand=Ajani, Nacatl Pariah
  humanbattlefield=Plains;Plains
script:
  p1: cast Ajani, Nacatl Pariah
  p1: pass
  p2: pass
expect:
  controls p1 "Cat Warrior Token"
  pt p1 "Cat Warrior Token" 2/1

=== ajani-flips-when-cat-dies
title: Ajani transforms into a planeswalker when another Cat you control dies
ref: Ajani, Nacatl Pariah Oracle
state:
  humanhand=Ajani, Nacatl Pariah
  humanbattlefield=Goblin Bombardment;Plains;Plains
script:
  p1: cast Ajani, Nacatl Pariah
  p1: pass
  p2: pass
  p1: wait-empty
  p1: activate Goblin Bombardment -> p2
  p1: pick Cat Warrior Token
  p1: pass
  p2: pass
  p1: pick yes
expect:
  controls p1 "Ajani, Nacatl Avenger"

=== sand-scout-fetches-desert
title: Sand Scout fetches a Desert (Lazotep Quarry) tapped when an opponent controls more lands
ref: Sand Scout Oracle
state:
  humanhand=Sand Scout
  humanbattlefield=Plains;Plains
  humanlibrary=Lazotep Quarry;Island;Island
  aibattlefield=Plains;Plains;Plains
script:
  p1: cast Sand Scout
  p1: pass
  p2: pass
expect:
  controls p1 "Lazotep Quarry"
  tapped p1 "Lazotep Quarry"

=== sand-scout-no-fetch-when-not-behind
title: Sand Scout does not fetch when the opponent does not control more lands
ref: Sand Scout Oracle (intervening if)
state:
  humanhand=Sand Scout
  humanbattlefield=Plains;Plains
  humanlibrary=Lazotep Quarry;Island;Island
  aibattlefield=Plains;Plains
script:
  p1: cast Sand Scout
  p1: pass
  p2: pass
expect:
  not controls p1 "Lazotep Quarry"

=== sand-scout-wasteland-makes-token
title: Sand Scout makes a Sand Warrior when a land card goes to your graveyard (sacrificed Wasteland)
ref: Sand Scout Oracle
state:
  humanbattlefield=Sand Scout;Wasteland
  aibattlefield=Tundra
script:
  p1: activate Wasteland ~Destroy -> Tundra
  p1: pass
  p2: pass
expect:
  controls p1 "Sand Warrior Token"
  zone p2 graveyard has "Tundra"

=== sand-scout-triggers-once-per-turn
title: Sand Scout's token trigger happens only once each turn even if two lands hit the graveyard
ref: Sand Scout Oracle
state:
  humanbattlefield=Sand Scout;Wasteland;Wasteland
  aibattlefield=Tundra;Scrubland
script:
  p1: activate Wasteland ~Destroy -> Tundra
  p1: pass
  p2: pass
  p1: activate Wasteland ~Destroy -> Scrubland
  p1: pass
  p2: pass
expect:
  zone p1 battlefield count "Sand Warrior Token" == 1

