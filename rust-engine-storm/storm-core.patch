+    pub(crate) fn put_outside_card_in_hand(&mut self, def: CardDefId, owner: Seat) -> ObjRef {
+        let r = self.s.alloc_outside_card(def, owner);
+        let slot = r.slot as usize;
+        {
+            let o = &mut self.s.objs[slot];
+            o.zone = ZoneKind::Hand;
+            o.card = Some(CardId(r.slot));
+        }
+        self.s.players[owner.idx()].hand.push(r);
+        let mut vid = [ViewId::NONE; 2];
+        for v in 0..2usize {
+            vid[v] = ViewId(self.s.next_vid[v]);
+            self.s.next_vid[v] += 1;
+        }
+        self.s.vids[slot] = vid;
+        self.s.knowledge[slot].known_to = 3;
+        self.s.knowledge[slot].pos_known_to = 0;
+        r
+    }
