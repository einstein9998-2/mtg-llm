+    /// Picks one of `from` at random (the discard of Gamble); a scenario can script which one, by
+    /// card definition.
+    pub(crate) fn pick_random_card(&mut self, p: Seat, from: &[ObjRef]) -> ObjRef {
+        if let Some(sc) = self.s.scripted.as_mut() {
+            match sc.queue.pop_front() {
+                Some((seat, RandKind::DiscardAtRandom, order)) if seat == p => {
+                    let objs = &self.s.objs;
+                    if let Some(r) = order.first().and_then(|d| from.iter().copied().find(|r| objs[r.slot as usize].def == *d)) {
+                        return r;
+                    }
+                    sc.violations += 1;
+                }
+                _ => sc.violations += 1,
+            }
+        }
+        from[self.s.rng.below(from.len() as u64) as usize]
+    }
+}
