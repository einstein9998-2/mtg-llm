diff -ruN a/crates/mtg-cards/tests/storm_load.rs b/crates/mtg-cards/tests/storm_load.rs
--- a/crates/mtg-cards/tests/storm_load.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/mtg-cards/tests/storm_load.rs	2026-10-06 05:47:51.271501880 +0000
@@ -0,0 +1,7 @@
+#[test]
+fn storm_loads() {
+    let db = mtg_cards::legacy::build();
+    for n in ["Taiga", "Burning Wish", "Gamble", "Beseech the Mirror", "Tendrils of Agony", "Urza's Saga", "Gaea's Will", "Hexing Squelcher", "Song of Creation"] {
+        assert!(db.id(n).is_some(), "{n}");
+    }
+}
