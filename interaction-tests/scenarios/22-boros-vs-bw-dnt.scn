=== solitude-evoke-exiles-and-sacrifices
title: Evoked Solitude exiles a white card from hand, its ETB exiles a creature, and it is sacrificed
ref: Solitude Oracle; CR 702.74 (evoke)
state:
  humanbattlefield=Ocelot Pride
  aihand=Solitude;Swords to Plowshares
  turn=2
  activeplayer=ai
  activephase=MAIN1
script:
  p2: cast Solitude ~Evoke
  p2: pick Swords to Plowshares
  p2: pass
  p1: pass
  p2: pick Ocelot Pride
expect:
  zone p1 exile has "Ocelot Pride"
  zone p2 exile has "Swords to Plowshares"
  zone p2 graveyard has "Solitude"
  not controls p2 "Solitude"

