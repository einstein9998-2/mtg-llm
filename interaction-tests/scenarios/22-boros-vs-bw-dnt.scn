  turn=2
  activeplayer=ai
  activephase=MAIN1
  humanbattlefield=Ocelot Pride
  aihand=Solitude
  aibattlefield=Plains;Plains;Plains;Plains;Plains
script:
  p2: cast Solitude
  p2: pass
  p1: pass
  p2: pick Ocelot Pride
