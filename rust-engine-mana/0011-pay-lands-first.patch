+        assert_eq!((d.pool_used[B.idx()], d.taps.len()), (2, 0), "default spends the pool first");
+        let l = plan_payment_with([0; 6], [0; 10], 2, &pool, &s, true).unwrap();
+        assert_eq!((l.pool_used[B.idx()], l.taps.len()), (0, 2), "lands first taps the sources");
+        // {1}{B}: the colored pip still comes from the pool, the generic from a source.
+        let l = plan_payment_with([0, 0, 1, 0, 0, 0], [0; 10], 1, &pool, &s, true).unwrap();
+        assert_eq!((l.pool_used[B.idx()], l.taps.len()), (1, 1));
+    }
