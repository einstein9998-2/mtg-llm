  p2: cast Flickerwisp
  p2: pass
  p1: pass
  p2: pick Orc Army Token
  p2: at END_OF_TURN
  p2: pass
  p1: pass
expect:
  not controls p2 "Orc Army Token"

=== flickerwisp-on-skyclave-returns-card
title: Flickering Skyclave Apparition's exiled card: the old exile does not return; the Apparition's leave trigger gives an Illusion
ref: Skyclave Apparition Oracle; Flickerwisp Oracle (rulings: the card exiled by the first ETB is not returned, X/X token created)
state:
  turn=2
  activeplayer=ai
  activephase=MAIN1
  humanbattlefield=Goblin Bombardment
  aihand=Flickerwisp
  aibattlefield=Skyclave Apparition|Exiled;Plains;Plains;Plains
script:
  p2: cast Flickerwisp
  p2: pass
  p1: pass
  p2: pick Skyclave Apparition
expect:
  controls p2 "Flickerwisp"

