+/// A mana ability written as several engine abilities of one cost ("{T}, Pay 1 life: Add {R} or {W}" is one
+/// ability per color, RFC 0012) is one ability in Oracle order: this is whether `abs[i]` continues the one before it.
+fn continues_mana_group(abs: &[AbilityDef], i: usize) -> bool {
+    match (i.checked_sub(1).and_then(|p| abs.get(p)), abs.get(i)) {
+        (Some(AbilityDef::Activated(a)), Some(AbilityDef::Activated(b))) => a.is_mana && b.is_mana && a.cost == b.cost && a.cost.len() > 1,
+        _ => false,
+    }
+}
+
+/// Indices of the activated abilities in Oracle order (see `continues_mana_group`): the first of each group.
+pub(crate) fn oracle_activated(abs: &[AbilityDef]) -> Vec<usize> {
+    abs.iter().enumerate().filter_map(|(i, x)| (matches!(x, AbilityDef::Activated(_)) && !continues_mana_group(abs, i)).then_some(i)).collect()
+}
+
+/// The engine ability indices of the group that starts at `first`.
+pub(crate) fn mana_group(abs: &[AbilityDef], first: usize) -> Vec<usize> {
+    let mut v = vec![first];
+    let mut i = first + 1;
+    while i < abs.len() && continues_mana_group(abs, i) {
+        v.push(i);
+        i += 1;
+    }
+    v
+}
