      (label: "Target player scries X, then draws a card.", targets: [(players: You)], effect: Seq([Scry(X), Draw(who: Target(0), n: Const(1))])),
      (label: "Exile target creature with mana value X or less.", targets: [(objects: (types_any: "CREATURE", cmc_x_max: true))], effect: Exile(One(Target(0)))),
      (label: "Exile up to X target cards from graveyards.", targets: [(objects: (zone: Graveyard), optional: true, distinct: true, x_count: true)], effect: Exile(TargetsFrom(0))),
