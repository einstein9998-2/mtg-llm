+        let mut objs: Vec<ObjRef> = free.iter().map(|&i| lib[i]).collect();
+        rng.shuffle(&mut objs);
+        let l = &mut self.players[owner.idx()].library;
+        for (&i, r) in free.iter().zip(objs) {
+            l[i] = r;
+        }
+    }
