  (name: "Karn, the Great Creator", cost: "{4}", types: "PLANESWALKER", supertypes: "LEGENDARY", subtypes: ["Karn"], abilities: [
    Enters(filter: (self_only: true), effect: Counters(Loyalty, 5)),
    Restrict(who: Opp, what: CantActivate(sources: (types_any: "ARTIFACT"))),
    Activated(text: "+1: Until your next turn, up to one target noncreature artifact becomes an artifact creature with power and toughness each equal to its mana value.", cost: [Loyalty(1)],
      targets: [(objects: (types_any: "ARTIFACT", types_not: "CREATURE"), optional: true)],
      effect: Seq([Continuous(objs: One(Target(0)), layer: L4, effect: AddTypes("CREATURE"), until: YourNextTurn), SetPTX(objs: One(Target(0)), x: CmcOf(Target(0)), until: YourNextTurn)])),
  ]),
  (name: "Tezzeret, Cruel Captain", cost: "{3}", types: "PLANESWALKER", supertypes: "LEGENDARY", subtypes: ["Tezzeret"], abilities: [
    Enters(filter: (self_only: true), effect: Counters(Loyalty, 4)),
    Triggered(text: "Whenever an artifact you control enters, put a loyalty counter on Tezzeret.", on: Enters(filter: (types_any: "ARTIFACT", controller: You)), effect: AddCounters(objs: One(This), kind: Loyalty, n: Const(1))),
    Activated(text: "0: Untap target artifact or creature. If it's an artifact creature, put a +1/+1 counter on it.", cost: [Loyalty(0)], targets: [(objects: (types_any: "ARTIFACT | CREATURE"))],
      effect: Seq([Untap(One(Target(0))), If(cond: And([Matches(Target(0), (types_any: "ARTIFACT")), Matches(Target(0), (types_any: "CREATURE"))]), then: AddCounters(objs: One(Target(0)), kind: PlusOne, n: Const(1)))])),
    Activated(text: "-3: Search your library for an artifact card with mana value 1 or less, reveal it, put it into your hand, then shuffle.", cost: [Loyalty(-3)],
      effect: Search(filter: (zone: Library, types_any: "ARTIFACT", cmc: (Le, 1)), dest: Hand)),
    Activated(text: "-7: You get an emblem with \"At the beginning of combat on your turn, put three +1/+1 counters on target artifact you control. If it's not a creature, it becomes a 0/0 Robot artifact creature.\"", cost: [Loyalty(-7)],
      effect: CreateEmblem("Emblem: Tezzeret robots")),
  ]),
  (name: "Emblem: Tezzeret robots", types: "EMBLEM", is_token: true, abilities: [
    Triggered(text: "At the beginning of combat on your turn, put three +1/+1 counters on target artifact you control. If it's not a creature, it becomes a 0/0 Robot artifact creature.", zone: Command,
      on: BeginStep(step: BeginCombat, whose: You), targets: [(objects: (types_any: "ARTIFACT", controller: You))],
      effect: Seq([If(cond: Not(Matches(Target(0), (types_any: "CREATURE"))), then: Seq([Continuous(objs: One(Target(0)), layer: L4, effect: AddTypes("CREATURE"), until: Forever), Continuous(objs: One(Target(0)), layer: L4, effect: AddSubtypes(["Robot"]), until: Forever), Continuous(objs: One(Target(0)), layer: L7b, effect: SetPT(0, 0), until: Forever)])), AddCounters(objs: One(Target(0)), kind: PlusOne, n: Const(3))])),
  ]),
  (name: "Ugin, Eye of the Storms", cost: "{7}", types: "PLANESWALKER", supertypes: "LEGENDARY", subtypes: ["Ugin"], abilities: [
    Enters(filter: (self_only: true), effect: Counters(Loyalty, 7)),
