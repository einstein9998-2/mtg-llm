@@ -0,0 +1,7 @@
+#[test]
+fn tron_sideboard_loads() {
+    let db = mtg_cards::legacy::build();
+    for n in ["Eldrazi Confluence", "Argentum Masticore", "Mycosynth Lattice", "Summon: Bahamut"] {
+        assert!(db.id(n).is_some(), "{n}");
+    }
+}
