// The Legacy pool (eight decks). Oracle text per /mnt/project-files/rust-engine-spec/reference/oracle.json.
// Cards are added in the order the spec scenarios need them.
[
  // ---- basic and dual lands -------------------------------------------------------------------
  (name: "Plains", types: "LAND", supertypes: "BASIC", subtypes: ["Plains"]),
  (name: "Island", types: "LAND", supertypes: "BASIC", subtypes: ["Island"]),
  (name: "Swamp", types: "LAND", supertypes: "BASIC", subtypes: ["Swamp"]),
  (name: "Mountain", types: "LAND", supertypes: "BASIC", subtypes: ["Mountain"]),
  (name: "Forest", types: "LAND", supertypes: "BASIC", subtypes: ["Forest"]),
  (name: "Volcanic Island", types: "LAND", subtypes: ["Island", "Mountain"]),
  (name: "Tropical Island", types: "LAND", subtypes: ["Forest", "Island"]),
  (name: "Underground Sea", types: "LAND", subtypes: ["Island", "Swamp"]),
  (name: "Tundra", types: "LAND", subtypes: ["Plains", "Island"]),
  (name: "Badlands", types: "LAND", subtypes: ["Swamp", "Mountain"]),
  (name: "Scrubland", types: "LAND", subtypes: ["Plains", "Swamp"]),
  (name: "Plateau", types: "LAND", subtypes: ["Mountain", "Plains"]),
  (name: "Savannah", types: "LAND", subtypes: ["Forest", "Plains"]),

  // Surveil lands: enter tapped, surveil 1.
  (name: "Hedge Maze", types: "LAND", subtypes: ["Forest", "Island"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Thundering Falls", types: "LAND", subtypes: ["Island", "Mountain"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Elegant Parlor", types: "LAND", subtypes: ["Mountain", "Plains"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Meticulous Archive", types: "LAND", subtypes: ["Plains", "Island"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Shadowy Backstreet", types: "LAND", subtypes: ["Plains", "Swamp"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Undercity Sewers", types: "LAND", subtypes: ["Island", "Swamp"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),
  (name: "Raucous Theater", types: "LAND", subtypes: ["Swamp", "Mountain"], abilities: [
    Enters(filter: (self_only: true), effect: Tapped),
    Triggered(text: "When this land enters, surveil 1.", on: Enters(filter: (self_only: true)), effect: Surveil(Const(1))),
  ]),

  // Fetch lands.
  (name: "Flooded Strand", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Plains or Island card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Plains", "Island"]), dest: Battlefield)),
  ]),
  (name: "Polluted Delta", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for an Island or Swamp card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Island", "Swamp"]), dest: Battlefield)),
  ]),
  (name: "Scalding Tarn", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for an Island or Mountain card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Island", "Mountain"]), dest: Battlefield)),
  ]),
  (name: "Misty Rainforest", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Forest or Island card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Forest", "Island"]), dest: Battlefield)),
  ]),
  (name: "Verdant Catacombs", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Swamp or Forest card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Swamp", "Forest"]), dest: Battlefield)),
  ]),
  (name: "Bloodstained Mire", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Swamp or Mountain card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Swamp", "Mountain"]), dest: Battlefield)),
  ]),
  (name: "Arid Mesa", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Mountain or Plains card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Mountain", "Plains"]), dest: Battlefield)),
  ]),
  (name: "Marsh Flats", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Plains or Swamp card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Plains", "Swamp"]), dest: Battlefield)),
  ]),
  (name: "Windswept Heath", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a Forest or Plains card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", subtypes_any: ["Forest", "Plains"]), dest: Battlefield)),
  ]),
  (name: "Prismatic Vista", types: "LAND", abilities: [
    Activated(text: "{T}, Pay 1 life, Sacrifice this land: Search your library for a basic land card, put it onto the battlefield, then shuffle.", cost: [TapSelf, PayLife(1), SacrificeSelf],
      effect: Search(filter: (zone: Library, types_any: "LAND", supertypes_any: "BASIC"), dest: Battlefield)),
  ]),

  // Utility lands.
  (name: "Wasteland", types: "LAND", abilities: [
    Activated(text: "{T}: Add {C}.", cost: [TapSelf], is_mana: true, effect: AddMana(color: C, n: 1)),
    Activated(text: "{T}, Sacrifice this land: Destroy target nonbasic land.", cost: [TapSelf, SacrificeSelf], targets: [(objects: (types_any: "LAND", supertypes_not: "BASIC"))],
      effect: Destroy(One(Target(0)))),
  ]),
  (name: "Ancient Tomb", types: "LAND", abilities: [
    Activated(text: "{T}: Add {C}{C}. This land deals 2 damage to you.", cost: [TapSelf], is_mana: true, effect: Seq([AddMana(color: C, n: 2), Damage(amount: Const(2), to: Player(You))])),
  ]),
  (name: "City of Traitors", types: "LAND", abilities: [
    Triggered(text: "When you play another land, sacrifice this land.", on: LandPlayed(who: You, filter: (not_self: true)), effect: Sacrifice(One(This))),
    Activated(text: "{T}: Add {C}{C}.", cost: [TapSelf], is_mana: true, effect: AddMana(color: C, n: 2)),
  ]),
  (name: "Karakas", types: "LAND", supertypes: "LEGENDARY", abilities: [
    Activated(text: "{T}: Add {W}.", cost: [TapSelf], is_mana: true, effect: AddMana(color: W, n: 1)),
    Activated(text: "{T}: Return target legendary creature to its owner's hand.", cost: [TapSelf], targets: [(objects: (types_any: "CREATURE", supertypes_any: "LEGENDARY"))], effect: Bounce(One(Target(0)))),
  ]),

  // ---- mana artifacts, tokens --------------------------------------------------------------------
  (name: "Lotus Petal", cost: "{0}", types: "ARTIFACT", abilities: [
    Activated(text: "{T}, Sacrifice this artifact: Add one mana of any color.", cost: [TapSelf, SacrificeSelf], is_mana: true, effect: AddManaAny(n: Const(1))),
  ]),
  (name: "Lion's Eye Diamond", cost: "{0}", types: "ARTIFACT", abilities: [
    Activated(text: "Discard your hand, Sacrifice this artifact: Add three mana of any one color. Activate only as an instant.", cost: [DiscardHand, SacrificeSelf], is_mana: true, effect: AddManaAny(n: Const(3))),
  ]),
  (name: "Treasure Token", types: "ARTIFACT", subtypes: ["Treasure"], is_token: true, abilities: [
    Activated(text: "{T}, Sacrifice this artifact: Add one mana of any color.", cost: [TapSelf, SacrificeSelf], is_mana: true, effect: AddManaAny(n: Const(1))),
  ]),
  (name: "Goblin Token", types: "CREATURE", colors: "R", subtypes: ["Goblin"], pt: (1, 1), is_token: true),
  (name: "Zombie Token", types: "CREATURE", colors: "B", subtypes: ["Zombie"], pt: (2, 2), is_token: true),
  (name: "Skeleton Token", types: "CREATURE", colors: "B", subtypes: ["Skeleton"], pt: (1, 1), is_token: true),
  (name: "Cat Token", types: "CREATURE", colors: "W", subtypes: ["Cat"], pt: (1, 1), is_token: true),
  (name: "Sand Warrior Token", types: "CREATURE", colors: "R | G | W", subtypes: ["Sand", "Warrior"], pt: (1, 1), is_token: true),
  (name: "Orc Army Token", types: "CREATURE", colors: "B", subtypes: ["Orc", "Army"], pt: (0, 0), is_token: true),
  (name: "The Atropal", types: "CREATURE", colors: "B", supertypes: "LEGENDARY", subtypes: ["God", "Horror"], pt: (4, 4), keywords: "DEATHTOUCH", is_token: true),
  (name: "Monk Token", types: "CREATURE", colors: "W", subtypes: ["Monk"], pt: (1, 1), keywords: "PROWESS", is_token: true),

  // ---- cantrips and library manipulation ----------------------------------------------------------
  (name: "Brainstorm", cost: "{U}", types: "INSTANT", abilities: [
    Spell(effect: Seq([Draw(who: You, n: Const(3)), PutBack(Const(2))])),
  ]),
  (name: "Ponder", cost: "{U}", types: "SORCERY", abilities: [
    Spell(effect: Seq([Reorder(Const(3)), May(who: You, then: Shuffle(You)), Draw(who: You, n: Const(1))])),
  ]),
  (name: "Preordain", cost: "{U}", types: "SORCERY", abilities: [
    Spell(effect: Seq([Scry(Const(2)), Draw(who: You, n: Const(1))])),
  ]),
  (name: "Consider", cost: "{U}", types: "INSTANT", abilities: [
    Spell(effect: Seq([Surveil(Const(1)), Draw(who: You, n: Const(1))])),
  ]),
  (name: "Stock Up", cost: "{2}{U}", types: "SORCERY", abilities: [
    Spell(effect: LookTake(look: Const(5), take: 2)),
  ]),
  (name: "Flow State", cost: "{1}{U}", types: "SORCERY", abilities: [
    Spell(effect: If(
      cond: And([
        Controls(who: You, filter: (zone: Graveyard, types_any: "INSTANT"), at_least: 1),
        Controls(who: You, filter: (zone: Graveyard, types_any: "SORCERY"), at_least: 1),
      ]),
      then: LookTake(look: Const(3), take: 2),
      els: LookTake(look: Const(3), take: 1))),
  ]),
  (name: "Dark Ritual", cost: "{B}", types: "INSTANT", abilities: [
    Spell(effect: AddMana(color: B, n: 3)),
  ]),
  (name: "Faithless Looting", cost: "{R}", types: "SORCERY", abilities: [
    Spell(effect: Seq([Draw(who: You, n: Const(2)), Discard(who: You, n: Const(2))])),
    Alt(label: "flashback", key: "flashback", cost: [Mana("{2}{R}")], zone: Graveyard, exile_after: true),
  ]),

  // ---- counterspells and stack interaction -----------------------------------------------------------
  (name: "Daze", cost: "{1}{U}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (zone: Stack, stack: Spell))], effect: CounterUnless(target: 0, pays: "{1}")),
    Alt(label: "return an Island you control to its owner's hand", key: "return_island", cost: [ReturnToHand(subtypes_any: ["Island"])]),
  ]),
  (name: "Force of Will", cost: "{3}{U}{U}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (zone: Stack, stack: Spell))], effect: CounterSpell(0)),
    Alt(label: "pay 1 life and exile a blue card from your hand", key: "exile_blue_card", cost: [ExileFromHand(zone: Hand, colors_any: "U"), PayLife(1)]),
  ]),
  (name: "Force of Negation", cost: "{1}{U}{U}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (zone: Stack, stack: Spell, types_not: "CREATURE"))], effect: CounterSpellExile(0)),
    Alt(label: "exile a blue card from your hand", key: "exile_blue_card", cost: [ExileFromHand(zone: Hand, colors_any: "U")], cond: Not(IsActive(You))),
  ]),
  (name: "Stifle", cost: "{U}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (zone: Stack, stack: Ability))], effect: CounterAbility(0)),
  ]),
  (name: "Hydroblast", cost: "{U}", types: "INSTANT", abilities: [
    Spell(choose: (1, 1), modes: [
      (label: "Counter target spell if it's red", targets: [(objects: (zone: Stack, stack: Spell))],
        effect: If(cond: Matches(Target(0), (colors_any: "R")), then: CounterSpell(0))),
      (label: "Destroy target permanent if it's red", targets: [(objects: ())],
        effect: If(cond: Matches(Target(0), (colors_any: "R")), then: Destroy(One(Target(0))))),
    ]),
  ]),
  (name: "Pyroblast", cost: "{R}", types: "INSTANT", abilities: [
    Spell(choose: (1, 1), modes: [
      (label: "Counter target spell if it's blue", targets: [(objects: (zone: Stack, stack: Spell))],
        effect: If(cond: Matches(Target(0), (colors_any: "U")), then: CounterSpell(0))),
      (label: "Destroy target permanent if it's blue", targets: [(objects: ())],
        effect: If(cond: Matches(Target(0), (colors_any: "U")), then: Destroy(One(Target(0))))),
    ]),
  ]),

  // ---- removal ---------------------------------------------------------------------------------------
  (name: "Lightning Bolt", cost: "{R}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE | PLANESWALKER"), players: Any)],
          effect: Damage(amount: Const(3), to: Target(0))),
  ]),
  (name: "Unholy Heat", cost: "{R}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE | PLANESWALKER"))],
      effect: If(cond: Delirium(You), then: Damage(amount: Const(6), to: Target(0)), els: Damage(amount: Const(2), to: Target(0)))),
  ]),
  (name: "Abrade", cost: "{1}{R}", types: "INSTANT", abilities: [
    Spell(choose: (1, 1), modes: [
      (label: "Abrade deals 3 damage to target creature", targets: [(objects: (types_any: "CREATURE"))],
        effect: Damage(amount: Const(3), to: Target(0))),
      (label: "Destroy target artifact", targets: [(objects: (types_any: "ARTIFACT"))], effect: Destroy(One(Target(0)))),
    ]),
  ]),
  (name: "Pyroclasm", cost: "{1}{R}", types: "SORCERY", abilities: [
    Spell(effect: ForEach(filter: (types_any: "CREATURE"), body: Damage(amount: Const(2), to: Obj(Each(0))))),
  ]),
  (name: "Dismember", cost: "{1}{B/P}{B/P}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE"))],
      effect: Continuous(objs: One(Target(0)), layer: L7c, effect: ModifyPT(-5, -5), until: EndOfTurn)),
  ]),
  (name: "Bitter Triumph", cost: "{1}{B}", types: "INSTANT", abilities: [
    AddCost(options: [[Discard(zone: Hand)], [PayLife(3)]], optional: false),
    Spell(targets: [(objects: (types_any: "CREATURE | PLANESWALKER"))], effect: Destroy(One(Target(0)))),
  ]),
  (name: "Snuff Out", cost: "{3}{B}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE", colors_not: "B"))], effect: Destroy(One(Target(0)))),
    Alt(label: "pay 4 life", key: "pay_life", cost: [PayLife(4)], cond: Controls(who: You, filter: (subtypes_any: ["Swamp"]), at_least: 1)),
  ]),
  (name: "Massacre", cost: "{2}{B}{B}", types: "SORCERY", abilities: [
    Spell(effect: Continuous(objs: All(types_any: "CREATURE"), layer: L7c, effect: ModifyPT(-2, -2), until: EndOfTurn)),
    Alt(label: "without paying its mana cost", key: "free", cost: [], cond: And([
      Controls(who: Opp, filter: (subtypes_any: ["Plains"]), at_least: 1),
      Controls(who: You, filter: (subtypes_any: ["Swamp"]), at_least: 1),
    ])),
  ]),
  (name: "Swords to Plowshares", cost: "{W}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE"))],
      effect: Seq([GainLife(who: ControllerOf(Target(0)), n: PowerOf(Target(0))), Exile(One(Target(0)))])),
  ]),
  (name: "Path to Exile", cost: "{W}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE"))],
      effect: Seq([
        Exile(One(Target(0))),
        May(who: ControllerOf(Target(0)),
          then: Search(who: ControllerOf(Target(0)), filter: (zone: Library, types_any: "LAND", supertypes_any: "BASIC"), dest: Battlefield, tapped: true)),
      ])),
  ]),
  (name: "Erode", cost: "{W}", types: "INSTANT", abilities: [
    Spell(targets: [(objects: (types_any: "CREATURE | PLANESWALKER"))],
      effect: Seq([
        Destroy(One(Target(0))),
        May(who: ControllerOf(Target(0)),
          then: Search(who: ControllerOf(Target(0)), filter: (zone: Library, types_any: "LAND", supertypes_any: "BASIC"), dest: Battlefield, tapped: true)),
      ])),
  ]),
  (name: "Meltdown", cost: "{X}{R}", types: "SORCERY", abilities: [
    Spell(effect: ForEach(filter: (types_any: "ARTIFACT"),
      body: If(cond: Cmp(CmcOf(Each(0)), Le, X), then: Destroy(One(Each(0)))))),
  ]),
  (name: "Prismari Charm", cost: "{U}{R}", types: "INSTANT", abilities: [
    Spell(choose: (1, 1), modes: [
      (label: "Surveil 2, then draw a card", effect: Seq([Surveil(Const(2)), Draw(who: You, n: Const(1))])),
      (label: "Prismari Charm deals 1 damage to each of one or two targets",
        targets: [(objects: (types_any: "CREATURE | PLANESWALKER"), players: Any), (objects: (types_any: "CREATURE | PLANESWALKER"), players: Any, optional: true, distinct: true)],
        effect: Seq([Damage(amount: Const(1), to: Target(0)), Damage(amount: Const(1), to: Target(1))])),
      (label: "Return target nonland permanent to its owner's hand", targets: [(objects: (types_not: "LAND"))], effect: Bounce(One(Target(0)))),
    ]),
  ]),

  // ---- discard and graveyard ---------------------------------------------------------------------------
  (name: "Duress", cost: "{B}", types: "SORCERY", abilities: [
    Spell(targets: [(players: Opp)],
      effect: DiscardChoose(who: Target(0), filter: (zone: Hand, types_not: "CREATURE | LAND"))),
  ]),
  (name: "Thoughtseize", cost: "{B}", types: "SORCERY", abilities: [
    Spell(targets: [(players: Any)],
      effect: Seq([DiscardChoose(who: Target(0), filter: (zone: Hand, types_not: "LAND")), LoseLife(who: You, n: Const(2))])),
  ]),
  (name: "Unmask", cost: "{3}{B}", types: "SORCERY", abilities: [
    Spell(targets: [(players: Any)], effect: DiscardChoose(who: Target(0), filter: (zone: Hand, types_not: "LAND"))),
    Alt(label: "exile a black card from your hand", key: "exile_black_card", cost: [ExileFromHand(zone: Hand, colors_any: "B")]),
  ]),
  (name: "Reanimate", cost: "{B}", types: "SORCERY", abilities: [
    Spell(targets: [(objects: (zone: Graveyard, types_any: "CREATURE"))],
      effect: Seq([MoveTo(objs: One(Target(0)), to: Battlefield, ctrl: You), LoseLife(who: You, n: CmcOf(Target(0)))])),
  ]),

  // ---- wave 2a: delve, delirium, delayed triggers -----------------------------------------------------
  (name: "Murktide Regent", cost: "{5}{U}{U}", types: "CREATURE", subtypes: ["Dragon"], pt: (3, 3), keywords: "FLYING", abilities: [
    Delve,
    Enters(filter: (self_only: true), effect: CountersDelved(PlusOne)),
    Triggered(text: "Whenever an instant or sorcery card leaves your graveyard, put a +1/+1 counter on this creature.", on: ZoneChange(filter: (types_any: "INSTANT | SORCERY", owner: You), from: Some(Graveyard)),
      effect: AddCounters(objs: One(This), kind: PlusOne, n: Const(1))),
  ]),
  (name: "Dragon's Rage Channeler", cost: "{R}", types: "CREATURE", subtypes: ["Human", "Shaman"], pt: (1, 1), abilities: [
    Triggered(text: "Whenever you cast a noncreature spell, surveil 1.", on: SpellCast(caster: You, filter: (types_not: "CREATURE")), effect: Surveil(Const(1))),
    Static(layer: L6, applies_to: (self_only: true), effect: GrantKeywords("FLYING | MUST_ATTACK"), cond: Delirium(You)),
    Static(layer: L7c, applies_to: (self_only: true), effect: ModifyPT(2, 2), cond: Delirium(You)),
  ]),
  (name: "Mishra's Bauble", cost: "{0}", types: "ARTIFACT", abilities: [
    Activated(text: "{T}, Sacrifice this artifact: Look at the top card of target player's library.", cost: [TapSelf, SacrificeSelf], targets: [(players: Any)],
      effect: Seq([LookTop(who: Target(0)), Delay(when: NextUpkeep, ability: 1)])),
    Triggered(text: "Draw a card at the beginning of the next turn's upkeep.", on: Delayed, effect: Draw(who: You, n: Const(1))),
  ]),

  // ---- wave 2b: equipment ------------------------------------------------------------------------------
  (name: "Cori-Steel Cutter", cost: "{1}{R}", types: "ARTIFACT", subtypes: ["Equipment"], abilities: [
    Static(layer: L6, applies_to: (equipped_by_source: true), effect: GrantKeywords("TRAMPLE | HASTE")),
    Static(layer: L7c, applies_to: (equipped_by_source: true), effect: ModifyPT(1, 1)),
    Triggered(text: "Flurry — Whenever you cast your second spell each turn, create a 1/1 white Monk creature token with prowess. You may attach this Equipment to it.", on: SpellCast(caster: You, nth: Some(2)),
      effect: Seq([CreateToken(token: "Monk Token", n: Const(1), who: You), May(who: You, then: Attach(what: This, to: Moved(0)))])),
    Activated(text: "Equip {1}{R}", cost: [Mana("{1}{R}")], timing: Sorcery, targets: [(objects: (types_any: "CREATURE", controller: You))], effect: Attach(what: This, to: Target(0))),
  ]),

  // ---- wave 2c: flicker, evoke, enters replacements -----------------------------------------------------
  (name: "Phelia, Exuberant Shepherd", cost: "{1}{W}", types: "CREATURE", supertypes: "LEGENDARY", subtypes: ["Dog"], pt: (2, 2), keywords: "FLASH", abilities: [
    Triggered(text: "Whenever Phelia attacks, exile up to one other target nonland permanent.", on: Attacks(filter: (self_only: true)),
      targets: [(objects: (types_not: "LAND", not_self: true), optional: true)],
      effect: ExileUntil(objs: One(Target(0)), when: NextEndStep, ability: 1)),
    // The delayed return; a +1/+1 counter if the card came back under its exiler's control.
    Triggered(text: "At the beginning of the next end step, return that card to the battlefield under its owner's control. If it entered under your control, put a +1/+1 counter on Phelia.", on: Delayed, effect: Seq([
      MoveTo(objs: Captured, to: Battlefield),
      If(cond: ControlledBy(Moved(0), You), then: AddCounters(objs: One(This), kind: PlusOne, n: Const(1))),
    ])),
