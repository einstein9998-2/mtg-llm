 /// Exactness: colored pips are payable iff a matching saturating them exists, and generic is
 /// payable iff enough unmatched sources remain, so this is a complete decision procedure.
 pub fn plan_payment(pips: [u8; 6], hyb: [u8; 10], generic: u32, pool: &ManaPool, sources: &[ManaSource]) -> Option<Payment> {
+    plan_payment_with(pips, hyb, generic, pool, sources, LANDS_FIRST.load(std::sync::atomic::Ordering::Relaxed))
+}
+
+/// `plan_payment` with the generic-cost policy given: `lands_first` is the player's choice (601.2h)
+/// to pay colored costs from floating mana but generic from sources first, falling back to the
+/// default policy when the sources cannot pay.
+pub fn plan_payment_with(pips: [u8; 6], hyb: [u8; 10], generic: u32, pool: &ManaPool, sources: &[ManaSource], lands_first: bool) -> Option<Payment> {
+    if lands_first {
+        if let Some(p) = plan_payment_inner(pips, hyb, generic, pool, sources, false) {
+            return Some(p);
+        }
+    }
+    plan_payment_inner(pips, hyb, generic, pool, sources, true)
+}
+
+static LANDS_FIRST: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Interface hook for the LLM game harness (process-wide, off by default; nothing in the engine, the
+/// fuzzers or the tests sets it): when set, generic costs are paid from sources before floating mana
+/// (colored costs still use floating mana first). Falls back to the default policy if sources cannot pay.
+pub fn set_lands_first(on: bool) {
+    LANDS_FIRST.store(on, std::sync::atomic::Ordering::Relaxed);
+}
