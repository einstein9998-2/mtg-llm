# Manabases (fetch and surveil lands), Preordain, Erode, Bilbo, Koma, and the common sideboard hate cards against Reanimator and Doomsday.
# Conventions: p1 = first seat, p2 = second seat, both scripted; see ../README.md.

=== fetch-delta-finds-underground-sea
title: Polluted Delta pays 1 life, is sacrificed, and fetches an untapped Underground Sea (dual land with basic land types)
ref: Polluted Delta Oracle (Island or Swamp card)
state:
  humanbattlefield=Polluted Delta
  humanlibrary=Underground Sea;Plateau;Island
script:
  p1: activate Polluted Delta
  p1: pick Underground Sea
  p1: pass
  p2: pass
expect:
  life p1 == 19
  controls p1 "Underground Sea"
  untapped p1 "Underground Sea"
  zone p1 graveyard has "Polluted Delta"

=== fetch-delta-cannot-find-plateau
title: Polluted Delta cannot fetch Plateau (Mountain Plains has neither Island nor Swamp type)
ref: Polluted Delta Oracle
state:
  humanbattlefield=Polluted Delta
  humanlibrary=Plateau;Underground Sea
script:
  p1: activate Polluted Delta
  p1: pick !Plateau
  p1: pass
  p2: pass
expect:
  not controls p1 "Plateau"

