// UR Cutter alternate (Brady's list, 2026-10-07), RFC 0009. Oracle text per Savecraft card_search (Scryfall), 2026-10-07.
// Kept apart from legacy.cards.ron so that the pinned real-pool snapshot and its goldens stay untouched.
[
  (name: "Otter Token", types: "CREATURE", colors: "U | R", subtypes: ["Otter"], pt: (1, 1), keywords: "PROWESS", is_token: true),
  // A Class (CR 716): it enters with level 1; the level counter is the Class level. Level-up abilities are sorcery-speed
  // activated abilities that need the previous level; level 3's static-style trigger needs level 3 or more.
  (name: "Stormchaser's Talent", cost: "{U}", types: "ENCHANTMENT", subtypes: ["Class"], abilities: [
    Class,
    Triggered(text: "When this Class enters, create a 1/1 blue and red Otter creature token with prowess.", on: Enters(filter: (self_only: true)),
      effect: CreateToken(token: "Otter Token", n: Const(1), who: You)),
    Activated(text: "{3}{U}: Level 2", cost: [Mana("{3}{U}")], timing: Sorcery, cond: Cmp(Counters(This, Level), Eq, Const(1)),
      effect: AddCounters(objs: One(This), kind: Level, n: Const(1))),
    Triggered(text: "When this Class becomes level 2, return target instant or sorcery card from your graveyard to your hand.", on: ClassLevel(2),
      targets: [(objects: (zone: Graveyard, types_any: "INSTANT | SORCERY", owner: You))], effect: MoveTo(objs: One(Target(0)), to: Hand)),
    Activated(text: "{5}{U}: Level 3", cost: [Mana("{5}{U}")], timing: Sorcery, cond: Cmp(Counters(This, Level), Eq, Const(2)),
      effect: AddCounters(objs: One(This), kind: Level, n: Const(1))),
    Triggered(text: "Whenever you cast an instant or sorcery spell, create a 1/1 blue and red Otter creature token with prowess.",
      on: SpellCast(caster: You, filter: (types_any: "INSTANT | SORCERY")), cond: Cmp(Counters(This, Level), Ge, Const(3)),
      effect: CreateToken(token: "Otter Token", n: Const(1), who: You)),
  ]),
  // Divided damage is modelled as four target slots, one point each; a creature chosen in k slots takes k damage in one event (RFC 0009).
  (name: "Pyrokinesis", cost: "{4}{R}{R}", types: "INSTANT", abilities: [
    Spell(targets: [
        (objects: (types_any: "CREATURE")),
        (objects: (types_any: "CREATURE"), ascending: true),
        (objects: (types_any: "CREATURE"), ascending: true),
        (objects: (types_any: "CREATURE"), ascending: true),
      ], effect: DamageSlots(per: Const(1), first: 0, n: 4)),
    Alt(label: "exile a red card from your hand", key: "exile_red_card", cost: [ExileFromHand(zone: Hand, colors_any: "R")]),
  ]),
  (name: "Price of Progress", cost: "{1}{R}", types: "INSTANT", abilities: [
    Spell(effect: Seq([
      Damage(amount: Times(Const(2), Count(types_any: "LAND", supertypes_not: "BASIC", controller: You)), to: Player(You)),
      Damage(amount: Times(Const(2), Count(types_any: "LAND", supertypes_not: "BASIC", controller: Opp)), to: Player(Opp)),
    ])),
  ]),
]
