title: Lotus Petal sacrificed for blue mana pays for Brainstorm
ref: Lotus Petal Oracle
state:
  humanhand=Brainstorm
  humanbattlefield=Lotus Petal
script:
  p1: cast Brainstorm
  p1: wait-empty
expect:
  zone p1 graveyard has "Lotus Petal"
  zone p1 graveyard has "Brainstorm"

=== mishra-bauble-delayed-draw
title: Mishra's Bauble: look at the top card now, draw at the beginning of the next turn's upkeep (opponent's upkeep)
ref: Mishra's Bauble Oracle
state:
  humanbattlefield=Mishra's Bauble
  humanlibrary=Brainstorm;Island;Island
script:
  p1: activate Mishra's Bauble -> p2
  p1: at p2:UPKEEP
  p1: wait-empty
expect:
  zone p1 hand has "Brainstorm"
  zone p1 graveyard has "Mishra's Bauble"

=== brainstorm-put-back-two
title: Brainstorm: draw three, put two on top of library
ref: Brainstorm Oracle
state:
  humanhand=Brainstorm
  humanbattlefield=Island
  humanlibrary=Lightning Bolt;Ponder;Stock Up;Island;Island
script:
  p1: cast Brainstorm
  p1: pick Ponder
  p1: pick Stock Up
  p1: wait-empty
expect:
  zone p1 hand has "Lightning Bolt"
  zone p1 hand size == 1
  zone p1 library size == 4

=== stock-up-chooses-two-of-five
title: Stock Up: look at the top five, put two into hand, the rest on the bottom
ref: Stock Up Oracle
state:
  humanhand=Stock Up
  humanbattlefield=Island;Island;Island
  humanlibrary=Lightning Bolt;Ponder;Brainstorm;Island;Force of Will;Aluren;Show and Tell
script:
  p1: cast Stock Up
  p1: pick Force of Will; Brainstorm
  p1: wait-empty
expect:
  zone p1 hand has "Force of Will"
  zone p1 hand has "Brainstorm"
  zone p1 hand size == 2
  zone p1 library size == 5
